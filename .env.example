# ─────────────────────────────────────────────────────────────────────────
# Digital Worker — configuration. Copy this file to ".env" and fill in values.
# ─────────────────────────────────────────────────────────────────────────

# --- OpenAI (required) ----------------------------------------------------
# Must be a vision-capable model for the annotated-screenshot perception.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# --- Perception -----------------------------------------------------------
# Backend that detects on-screen elements:
#   uia        = native Windows UI Automation tree only (no GPU needed)
#   omniparser = local OmniParser GPU server (set OMNIPARSER_API_URL)
#   hybrid     = UIA first, OmniParser fallback only if UIA finds nothing (default)
PERCEPTION_BACKEND=hybrid

# Text-only perception by default — no screenshot is sent to the LLM; it reasons
# over the structured UI Automation tree. Set true to ALSO attach a screenshot
# (only useful for multimodal models).
USE_VISION=false
SET_OF_MARK=true

# Downscale + JPEG-compress the screenshot sent to the model (faster/cheaper
# vision calls; click accuracy is unaffected — actions resolve via element IDs).
# 0 = send full resolution.
VISION_MAX_WIDTH=1280
VISION_JPEG_QUALITY=70

# UI Automation tree-walk limits (raise for very dense apps, lower for speed).
UIA_MAX_ELEMENTS=150
UIA_MAX_NODES=3000
UIA_MAX_DEPTH=30

# --- OmniParser (only if PERCEPTION_BACKEND uses it) ----------------------
OMNIPARSER_API_URL=http://localhost:8000/process
OMNIPARSER_BOX_THRESHOLD=0.05
OMNIPARSER_IOU_THRESHOLD=0.1
OMNIPARSER_USE_PADDLEOCR=true
OMNIPARSER_IMGSZ=640

# --- Worker behaviour -----------------------------------------------------
USE_PLANNER=true

# Visible-GUI mode is the default: the agent makes folders/files/documents by
# operating the real apps on screen (File Explorer, Notepad/Word, browser).
# Set true to ALSO allow silent helpers that create files / run shell commands
# directly (faster, but the user doesn't see it happen).
ENABLE_POWER_TOOLS=false

MAX_AGENT_ITERATIONS=80
MAX_ACTION_RETRIES=4
# Lower = faster (and less idle time between actions).
SCREENSHOT_DELAY=0.3
ACTION_PAUSE=0.2
MOUSE_MOVE_DURATION=0.15
TYPING_INTERVAL=0.02

# --- Per-action verification (off by default) -----------------------------
# When on, each action is LLM-judged against the next screen. Auto-undo (Ctrl+Z)
# is separate and stays off unless you really want it.
VERIFY_AFTER_ACTION=false
VERIFY_AUTO_UNDO=false
VERIFICATION_DELAY=1.0

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
